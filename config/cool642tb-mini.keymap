#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball_listener {
    compatible = "zmk,input-listener";
    snipe {
        layers = <3>;
        input-processors = <&zip_xy_scaler 1 2>;
     }
};

/ {
    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp L         &kp U         &kp COMMA         &kp PERIOD                                        &kp F                    &kp W    &lt 4 R  &lt 4 Y  &kp P
&mt LEFT_CONTROL E  &kp I         &kp A         &kp O             &mt LEFT_GUI MINUS  &kp LC(Y)        &none        &kp K                    &lt 4 T  &kp N    &kp S    &kp H
&mt LEFT_SHIFT Z    &kp X         &kp C         &kp V             &kp SEMICOLON       &kp LC(Z)        &none        &kp G                    &lt 5 D  &kp M    &kp J    &kp B
&kp ESCAPE          &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 LANGUAGE_2  &lt 2 LANGUAGE_1    &lt 7 SPACE      &lt 1 ENTER  &mt RIGHT_ALT BACKSPACE                             &kp QUESTION
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUM {
            bindings = <
&kp N1  &kp N2  &kp N3     &kp N4   &kp N5                           &kp N6    &kp N7          &kp N8        &kp N9     &kp N0
&none   &none   &kp SLASH  &kp DOT  &kp MINUS  &none       &kp HOME  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp BACKSPACE
&kp F1  &kp F2  &kp F3     &kp F4   &kp F5     &trans      &trans    &kp F6    &kp F7          &kp F8        &kp F9     &kp UNDER
&trans  &trans  &trans     &trans   &trans     &trans      &trans    &trans                                             &kp F11
            >;
        };

        FUNC {
            bindings = <
&kp LS(EXCL)      &kp DOUBLE_QUOTES  &kp LS(POUND)  &kp LS(DLLR)   &kp LS(PRCNT)                      &kp AMPS  &kp SINGLE_QUOTE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT
&kp LC(W)         &kp LA(D)          &kp LS(T)      &kp LC(S)      &none          &none       &none   &none     &none             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp ASTERISK
&kp LC(NUMBER_2)  &kp LS(LC(R))      &kp LS(LC(C))  &kp LS(LG(S))  &none          &trans      &trans  &trans    &trans            &kp LESS_THAN         &kp GREATER_THAN       &kp SLASH
&trans            &trans             &trans         &trans         &trans         &trans      &trans  &trans                                                                   &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp LS(LC(TAB))   &kp UP_ARROW  &kp LC(TAB)        &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME    &kp LEFT          &kp DOWN      &kp RIGHT          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp LG(LS(LEFT))  &trans        &kp LG(LS(RIGHT))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans            &trans        &trans             &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans        &trans        &trans        &trans        &trans                            &trans  &trans     &mkp MCLK  &mkp RCLK  &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans  &trans  &mkp LCLK  &mkp MB4   &mkp MB5   &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans     &trans     &trans     &trans
&bt BT_CLR    &trans        &trans        &trans        &trans        &trans      &trans  &trans                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        UPPER_CASE {
            bindings = <
&kp LS(Q)  &kp LS(L)  &kp LS(U)  &trans     &trans                             &kp LS(F)      &kp LS(W)  &kp LS(R)  &kp LS(Y)  &kp LS(P)
&kp LS(E)  &kp LS(I)  &kp LS(A)  &kp LS(O)  &trans  &trans      &trans         &kp LS(K)      &kp LS(T)  &kp LS(N)  &kp LS(S)  &kp LS(H)
&kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &trans  &trans      &trans         &kp LS(G)      &kp LS(D)  &kp LS(M)  &kp LS(J)  &kp LS(B)
&trans     &trans     &trans     &trans     &trans  &trans      &kp LS(ENTER)  &kp BACKSPACE                                   &trans
            >;
        };
    };
};
